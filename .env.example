# ===========================================
# DATABASE
# ===========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ambubook"

# ===========================================
# BETTER AUTH
# ===========================================
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# ===========================================
# RESEND (Emails)
# ===========================================
RESEND_API_KEY="re_xxxxxxxx"
ADMIN_EMAIL="ton@email.fr"
FROM_EMAIL="AmbuBook <noreply@ambubook.fr>"

# ===========================================
# BOOTSTRAP ADMIN (script scripts/create-admin.ts)
# ===========================================
# Réutilise ADMIN_EMAIL ci-dessus. ADMIN_PASSWORD facultatif :
# si vide, un mot de passe fort est généré et affiché une seule fois.
ADMIN_PASSWORD=""
ADMIN_NAME="Administrateur"

# ===========================================
# TWILIO (SMS)
# ===========================================
TWILIO_ACCOUNT_SID="twilio-account-sid"
TWILIO_AUTH_TOKEN="twilio-auth-token"
TWILIO_PHONE_NUMBER="+33xxxxxxxxx"

# ===========================================
# SCALEWAY OBJECT STORAGE (S3)
# ===========================================
S3_REGION="fr-par"
S3_ENDPOINT="https://s3.fr-par.scw.cloud"
S3_BUCKET="ambubook-attachments"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"

# ===========================================
# CRON SECRET
# ===========================================
CRON_SECRET="generate-with-openssl-rand-base64-32"

# ===========================================
# CHIFFREMENT DES DONNÉES SENSIBLES (n° Sécu)
# ===========================================
# Clé AES-256 (32 octets en base64). Générer avec : openssl rand -base64 32
# ⚠️ Ne jamais changer cette clé une fois des données chiffrées en base,
# sous peine de rendre le n° de Sécu illisible.
ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# ===========================================
# Google OAuth
# ===========================================
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ===========================================
# AXEPTIO (Cookies consent)
# ===========================================
NEXT_PUBLIC_AXEPTIO_CLIENT_ID="your-axeptio-client-id"